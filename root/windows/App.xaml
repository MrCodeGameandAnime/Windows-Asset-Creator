<Application
    x:Class="WindowsAssetCreator.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="WacCanvasBrush" Color="#EEF3F8" />
        <SolidColorBrush x:Key="WacSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WacSurfaceSubtleBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="WacBoardBrush" Color="#FBFCFE" />
        <SolidColorBrush x:Key="WacFooterBrush" Color="#F7F9FC" />
        <SolidColorBrush x:Key="WacBorderBrush" Color="#CFDAE6" />
        <SolidColorBrush x:Key="WacDividerBrush" Color="#B8C6D6" />
        <SolidColorBrush x:Key="WacAccentSoftBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WacAccentBorderBrush" Color="#82B6F5" />
        <SolidColorBrush x:Key="WacAccentTextBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="WacMutedTextBrush" Color="#64748B" />

        <Style x:Key="WacSurfaceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WacSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WacBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="WacBoardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WacBoardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WacBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="WacIntakeSurfaceStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WacAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WacAccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style x:Key="WacAssetTileStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource WacSurfaceSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WacBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
