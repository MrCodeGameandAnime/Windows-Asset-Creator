<Window
    x:Class="WindowsAssetCreator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsAssetCreator">
    <Grid Padding="24" RowSpacing="12" Background="{StaticResource WacCanvasBrush}">
        <Grid.Resources>
        <DataTemplate x:Key="WacSkeletonAssetTileTemplate">
            <Border Width="152" Margin="0,0,10,10" Padding="8"
                    Style="{StaticResource WacAssetTileStyle}" Opacity="0.58">
                <StackPanel Spacing="6">
                    <Border Height="104" Padding="8" Background="{StaticResource WacCanvasBrush}"
                            CornerRadius="6">
                        <Border Width="72" Height="72" Background="{StaticResource WacSurfaceSubtleBrush}"
                                CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Height="14" Width="116" HorizontalAlignment="Left"
                            Background="{StaticResource WacBorderBrush}" CornerRadius="4" />
                    <Border Height="12" Width="64" HorizontalAlignment="Left"
                            Background="{StaticResource WacBorderBrush}" CornerRadius="4" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="WacSkeletonItemsControlStyle" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource WacSkeletonAssetTileTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="162" ItemHeight="190" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="10">
            <Border x:Name="ReplacementDropSurface" Padding="10,6"
                    Style="{StaticResource WacIntakeSurfaceStyle}"
                    Visibility="{x:Bind ViewModel.ReplacementDropTargetVisibility, Mode=OneWay}"
                    AutomationProperties.Name="Drop another source image or browse" AllowDrop="True"
                    DragOver="DropSurface_DragOver" Drop="DropSurface_Drop">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Drop another PNG or JPEG here, or browse…"
                               VerticalAlignment="Center" Foreground="{StaticResource WacAccentTextBrush}" />
                    <Button Grid.Column="1" Content="Browse…" AutomationProperties.Name="Choose another source image"
                            Click="Browse_Click" />
                </Grid>
            </Border>
            <Border Padding="12" Style="{StaticResource WacSurfaceCardStyle}"
                    Visibility="{x:Bind ViewModel.SourceSummaryVisibility, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" Style="{StaticResource WacAssetTileStyle}" CornerRadius="6">
                        <Image Source="{x:Bind ViewModel.SourcePreview, Mode=OneWay}" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{x:Bind ViewModel.SourceName, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.SourceDimensions, Mode=OneWay}"
                                   Foreground="{StaticResource WacMutedTextBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SourceFramingNote, Mode=OneWay}" TextWrapping="Wrap"
                                   Foreground="{StaticResource WacMutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="EmptyDropHost" MinHeight="196"
                  Visibility="{x:Bind ViewModel.EmptyDropTargetVisibility, Mode=OneWay}"
                  AutomationProperties.Name="Choose or drop a source image" AllowDrop="True"
                  DragOver="DropSurface_DragOver" Drop="DropSurface_Drop">
                <Border x:Name="DropSurface" Margin="8" MinHeight="172" Padding="28"
                        VerticalAlignment="Center" Style="{StaticResource WacIntakeSurfaceStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="Drag and drop a PNG or JPEG" HorizontalAlignment="Center"
                                   Foreground="{StaticResource WacAccentTextBrush}"
                                   Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Button Content="Browse…" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Choose source image" Click="Browse_Click" />
                    </StackPanel>
                </Border>
            </Grid>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Foreground="{StaticResource WacAccentTextBrush}" HorizontalAlignment="Left" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="16" Style="{StaticResource WacBoardCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <StackPanel x:Name="EmptyBoardPlaceholder" Spacing="16"
                                Visibility="{x:Bind ViewModel.EmptyBoardVisibility, Mode=OneWay}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="AppList" FontSize="22" FontWeight="SemiBold" Opacity="0.8" />
                            <Border Padding="16" Style="{StaticResource WacSurfaceCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Default" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <ItemsControl Style="{StaticResource WacSkeletonItemsControlStyle}">
                                            <ItemsControl.Items>
                                                <x:String></x:String><x:String></x:String><x:String></x:String><x:String></x:String>
                                            </ItemsControl.Items>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Unplated" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <ItemsControl Style="{StaticResource WacSkeletonItemsControlStyle}">
                                            <ItemsControl.Items>
                                                <x:String></x:String><x:String></x:String><x:String></x:String><x:String></x:String>
                                            </ItemsControl.Items>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Light unplated" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <ItemsControl Style="{StaticResource WacSkeletonItemsControlStyle}">
                                            <ItemsControl.Items>
                                                <x:String></x:String><x:String></x:String><x:String></x:String><x:String></x:String>
                                            </ItemsControl.Items>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Logo families" FontSize="22" FontWeight="SemiBold" Opacity="0.8" />
                            <Border Padding="16" Style="{StaticResource WacSurfaceCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Square 44" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <ItemsControl Style="{StaticResource WacSkeletonItemsControlStyle}">
                                            <ItemsControl.Items>
                                                <x:String></x:String><x:String></x:String><x:String></x:String><x:String></x:String>
                                            </ItemsControl.Items>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Square 150" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <ItemsControl Style="{StaticResource WacSkeletonItemsControlStyle}">
                                            <ItemsControl.Items>
                                                <x:String></x:String><x:String></x:String><x:String></x:String><x:String></x:String>
                                            </ItemsControl.Items>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Store logo" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <ItemsControl Style="{StaticResource WacSkeletonItemsControlStyle}">
                                            <ItemsControl.Items>
                                                <x:String></x:String><x:String></x:String><x:String></x:String><x:String></x:String>
                                            </ItemsControl.Items>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Medium tile" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <ItemsControl Style="{StaticResource WacSkeletonItemsControlStyle}">
                                            <ItemsControl.Items>
                                                <x:String></x:String><x:String></x:String><x:String></x:String><x:String></x:String>
                                            </ItemsControl.Items>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Wide 310 × 150" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <ItemsControl Style="{StaticResource WacSkeletonItemsControlStyle}">
                                            <ItemsControl.Items>
                                                <x:String></x:String><x:String></x:String><x:String></x:String><x:String></x:String>
                                            </ItemsControl.Items>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="App icon" FontSize="22" FontWeight="SemiBold" Opacity="0.8" />
                            <Border Padding="16" Style="{StaticResource WacSurfaceCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Windows icon" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    <ItemsControl Style="{StaticResource WacSkeletonItemsControlStyle}">
                                        <ItemsControl.Items>
                                            <x:String></x:String>
                                        </ItemsControl.Items>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="GeneratedBoard" Spacing="12"
                                Visibility="{x:Bind ViewModel.GeneratedBoardVisibility, Mode=OneWay}">
                        <InfoBar IsOpen="{x:Bind ViewModel.HasValidationSuccess, Mode=OneWay}"
                                 IsClosable="False" Severity="Success"
                                 Title="{x:Bind ViewModel.ValidationText, Mode=OneWay}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:AssetBoardGroupViewModel">
                                    <StackPanel Spacing="10" Margin="0,0,0,16">
                                        <Grid Visibility="{x:Bind FamilyHeaderVisibility}" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind FamilyTitle}" Style="{ThemeResource TitleTextBlockStyle}" />
                                        </Grid>
                                        <Border Padding="16" Style="{StaticResource WacSurfaceCardStyle}">
                                            <StackPanel Spacing="12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Title}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind AssetCountText}"
                                                               VerticalAlignment="Center" Opacity="0.65" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{x:Bind Assets}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VariableSizedWrapGrid Orientation="Horizontal"
                                                                                   ItemWidth="162"
                                                                                   ItemHeight="190" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:AssetBoardItemViewModel">
                                                            <Border Width="152" Margin="0,0,10,10" Padding="8"
                                                                    Style="{StaticResource WacAssetTileStyle}">
                                                                <StackPanel Spacing="6">
                                                                    <Border Height="104" Padding="8"
                                                                            Background="{StaticResource WacCanvasBrush}"
                                                                            CornerRadius="6">
                                                                        <Image Source="{x:Bind Thumbnail}" Stretch="Uniform" />
                                                                    </Border>
                                                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{x:Bind Dimensions}"
                                                                               Foreground="{StaticResource WacMutedTextBrush}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Padding="12,8" Background="{StaticResource WacFooterBrush}"
                BorderBrush="{StaticResource WacDividerBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Reset" IsEnabled="{x:Bind ViewModel.CanReset, Mode=OneWay}" Click="Reset_Click" />
                <Button Grid.Column="2" Content="Save As…" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="Save generated asset ZIP as" Click="SaveAs_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
