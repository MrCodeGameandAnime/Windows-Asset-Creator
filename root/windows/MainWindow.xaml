<Window
    x:Class="WindowsAssetCreator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsAssetCreator">
    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <TextBlock Text="Windows Asset Creator" Style="{ThemeResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.SourceName, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.SourceDimensions, Mode=OneWay}" Opacity="0.7" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.SourceFramingNote, Mode=OneWay}" TextWrapping="Wrap" />
            <Border Padding="24" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Visibility="{x:Bind ViewModel.EmptyDropTargetVisibility, Mode=OneWay}"
                    AutomationProperties.Name="Choose or drop a source image">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="Drop a PNG or JPEG here" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Button Content="Browse…" AutomationProperties.Name="Choose source image" />
                </StackPanel>
            </Border>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Left" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock Text="Generated assets" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.ValidationText, Mode=OneWay}" Opacity="0.7" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:AssetBoardGroupViewModel">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Title}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <ItemsRepeater ItemsSource="{x:Bind Assets}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:AssetBoardItemViewModel">
                                            <StackPanel Spacing="2" Margin="0,0,0,8">
                                                <TextBlock Text="{x:Bind Label}" />
                                                <TextBlock Text="{x:Bind Dimensions}" Opacity="0.7" />
                                                <TextBlock Text="{x:Bind PreviewPath}" Opacity="0.55" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.SourceName, Mode=OneWay}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Reset" IsEnabled="False" />
            <Button Grid.Column="2" Content="Save As…" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                    AutomationProperties.Name="Save generated asset ZIP as" />
        </Grid>
    </Grid>
</Window>
