<Window
    x:Class="WindowsAssetCreator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WindowsAssetCreator">
    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="12">
            <TextBlock Text="Windows Asset Creator" Style="{ThemeResource TitleTextBlockStyle}" />
            <Border x:Name="ReplacementDropSurface" Padding="10,6"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Visibility="{x:Bind ViewModel.ReplacementDropTargetVisibility, Mode=OneWay}"
                    AutomationProperties.Name="Drop another source image or browse" AllowDrop="True"
                    Background="Transparent" DragOver="DropSurface_DragOver" Drop="DropSurface_Drop">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Drop another PNG or JPEG here, or browse…"
                               VerticalAlignment="Center" Opacity="0.7" />
                    <Button Grid.Column="1" Content="Browse…" AutomationProperties.Name="Choose another source image"
                            Click="Browse_Click" />
                </Grid>
            </Border>
            <Border Padding="12" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Visibility="{x:Bind ViewModel.SourceSummaryVisibility, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <Image Source="{x:Bind ViewModel.SourcePreview, Mode=OneWay}" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="{x:Bind ViewModel.SourceName, Mode=OneWay}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.SourceDimensions, Mode=OneWay}" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.SourceFramingNote, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="DropSurface" Padding="24" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Visibility="{x:Bind ViewModel.EmptyDropTargetVisibility, Mode=OneWay}"
                    AutomationProperties.Name="Choose or drop a source image" AllowDrop="True" Background="Transparent"
                    DragOver="DropSurface_DragOver" Drop="DropSurface_Drop">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="Drop a PNG or JPEG here" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Button Content="Browse…" AutomationProperties.Name="Choose source image" Click="Browse_Click" />
                </StackPanel>
            </Border>
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" HorizontalAlignment="Left" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" Severity="Error"
                     Message="{x:Bind ViewModel.ErrorText, Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <TextBlock Text="Generated assets" Style="{ThemeResource SubtitleTextBlockStyle}" />
                <InfoBar IsOpen="{x:Bind ViewModel.HasValidationSuccess, Mode=OneWay}"
                         IsClosable="False" Severity="Success"
                         Title="{x:Bind ViewModel.ValidationText, Mode=OneWay}"
                         Message="{x:Bind ViewModel.ValidationDetail, Mode=OneWay}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:AssetBoardGroupViewModel">
                            <StackPanel Spacing="10" Margin="0,0,0,16">
                                <Grid Visibility="{x:Bind FamilyHeaderVisibility}" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind FamilyTitle}" Style="{ThemeResource TitleTextBlockStyle}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind FamilySummary}"
                                               VerticalAlignment="Bottom" Opacity="0.65" />
                                </Grid>
                                <Border Padding="16"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="10">
                                    <StackPanel Spacing="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Title}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind AssetCountText}"
                                                       VerticalAlignment="Center" Opacity="0.65" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind Assets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <VariableSizedWrapGrid Orientation="Horizontal"
                                                                           ItemWidth="162"
                                                                           ItemHeight="190" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:AssetBoardItemViewModel">
                                                    <Border Width="152" Margin="0,0,10,10" Padding="8"
                                                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="8">
                                                        <StackPanel Spacing="6">
                                                            <Border Height="104" Padding="8"
                                                                    Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
                                                                    CornerRadius="6">
                                                                <Image Source="{x:Bind Thumbnail}" Stretch="Uniform" />
                                                            </Border>
                                                            <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind Dimensions}" Opacity="0.7" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="Reset" IsEnabled="{x:Bind ViewModel.CanReset, Mode=OneWay}" Click="Reset_Click" />
            <Button Grid.Column="2" Content="Save As…" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="Save generated asset ZIP as" Click="SaveAs_Click" />
        </Grid>
    </Grid>
</Window>
